#!/bin/sh
# Pre-commit hook: format check, vet, and tests.
# Install: make install-hooks
set -e

# Ensure go is available — activate mise shims if present, otherwise rely on PATH.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate sh --shims)" 2>/dev/null || true
fi
if ! command -v go >/dev/null 2>&1; then
  echo "pre-commit: 'go' not found in PATH; skipping checks (run 'make check' manually)"
  exit 0
fi

echo "→ gofmt"
out=$(gofmt -l ./internal ./cmd)
if [ -n "$out" ]; then
  echo "unformatted files (run 'make fmt'):"
  echo "$out"
  exit 1
fi
echo "→ go vet"
go vet ./...
echo "→ go test"
go test ./...
